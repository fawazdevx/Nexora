# Arbitrum One deployment template.
# Copy to contracts/.env.arbitrum-one locally, fill real values, then source it before forge scripts.

ARC_RPC_URL=https://arb1.arbitrum.io/rpc
ARC_CHAIN_ID=42161

# Deployer/owner config
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
AI_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Native USDC on Arbitrum One
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Nexora fees
NEXORA_FEE_BPS=250
NEXORA_WITHDRAWAL_FEE_BPS=100

# Fill after deployment if running upgrade scripts.
POLICY_REGISTRY_PROXY_ADDRESS=
OPERATOR_REPUTATION_PROXY_ADDRESS=
X402_LEDGER_PROXY_ADDRESS=
YIELD_ROUTER_PROXY_ADDRESS=
SAVE_EARN_VAULT_PROXY_ADDRESS=
NEXORA_ESCROW_PROXY_ADDRESS=
