pragma solidity ^0.8.24;

interface IERC20 {
    function balanceOf(address account) external view returns (uint256);
    function approve(address spender, uint256 value) external returns (bool);
    function transfer(address to, uint256 value) external returns (bool);
    function transferFrom(address from, address to, uint256 value) external returns (bool);
}

/// @notice EIP-3009 gasless authorization surface exposed by USDC (FiatTokenV2).
/// @dev `receiveWithAuthorization` enforces `msg.sender == to`, so only the
///      contract named as the recipient can pull the funds — the correct
///      primitive for contract pulls per Circle's guidance.
interface IERC3009 is IERC20 {
    function receiveWithAuthorization(
        address from,
        address to,
        uint256 value,
        uint256 validAfter,
        uint256 validBefore,
        bytes32 nonce,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external;

    function authorizationState(address authorizer, bytes32 nonce) external view returns (bool);
}
